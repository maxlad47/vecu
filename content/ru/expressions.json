{
  "langue": "ru",
  "titre": "Expression du jour",
  "statut": "valide-nadia",
  "note": "Une expression familière ou drôle par jour, affichée sur l'accueil. Pas d'exercice : c'est un clin d'œil. Rien de vulgaire, rien qui change selon le genre de la personne qui parle.",
  "expressions": [
    { "id": "ru-expr-001", "cible": "Давай!", "accent": "Дава́й!", "translit": "davái !", "fr": "Allez ! / Ça marche !", "note": "Le mot à tout faire : pour dire oui, au revoir ou « on y va »." },
    { "id": "ru-expr-002", "cible": "Ничего себе!", "accent": "Ничего́ себе́!", "translit": "nitchevó sebié !", "fr": "Ça alors !", "note": "Surprise, bonne ou mauvaise." },
    { "id": "ru-expr-003", "cible": "Блин!", "accent": "Блин!", "translit": "blin !", "fr": "Mince !", "note": "Littéralement « crêpe ». Un juron adouci, très courant." },
    { "id": "ru-expr-004", "cible": "Да ладно!", "accent": "Да ла́дно!", "translit": "da ládna !", "fr": "Sans blague !", "note": "Quand on n'y croit pas trop." },
    { "id": "ru-expr-005", "cible": "Круто!", "accent": "Кру́то!", "translit": "krúta !", "fr": "Trop bien !", "note": "Familier, partout chez les jeunes." },
    { "id": "ru-expr-006", "cible": "Всё пучком.", "accent": "Всё пучко́м.", "translit": "fsio poutchkóm.", "fr": "Tout roule.", "note": "Littéralement « tout est en botte », comme un bouquet bien serré." },
    { "id": "ru-expr-007", "cible": "Не парься.", "accent": "Не па́рься.", "translit": "nié pársia.", "fr": "T'inquiète, te prends pas la tête.", "note": "Entre amis. Littéralement « ne te mets pas au bain de vapeur »." },
    { "id": "ru-expr-008", "cible": "Мне по барабану.", "accent": "Мне по бараба́ну.", "translit": "mnié pa barabánou.", "fr": "Je m'en fiche.", "note": "Littéralement « pour moi, c'est sur le tambour »." },
    { "id": "ru-expr-009", "cible": "Проехали.", "accent": "Прое́хали.", "translit": "praiékhali.", "fr": "Laisse tomber, on passe.", "note": "Littéralement « on est passés (sans s'arrêter) »." },
    { "id": "ru-expr-010", "cible": "Ни пуха ни пера!", "accent": "Ни пу́ха ни пера́!", "translit": "ni poúkha ni pierá !", "fr": "Bonne chance !", "note": "On ne dit pas merci : on répond « К чёрту ! » (au diable !)." },
    { "id": "ru-expr-011", "cible": "Ржу не могу!", "accent": "Ржу́ не могу́!", "translit": "rjou nié magoú !", "fr": "Je suis mort de rire !", "note": "Littéralement « je hennis, je n'en peux plus »." },
    { "id": "ru-expr-012", "cible": "Вот это да!", "accent": "Вот э́то да!", "translit": "vot éta da !", "fr": "Waouh !", "note": "Admiration ou grosse surprise." },
    { "id": "ru-expr-013", "cible": "Не вопрос!", "accent": "Не вопро́с!", "translit": "nié vaprós !", "fr": "Pas de problème !", "note": "Littéralement « pas de question »." },
    { "id": "ru-expr-014", "cible": "Без разницы.", "accent": "Без ра́зницы.", "translit": "biez ráznitsy.", "fr": "Peu importe.", "note": "Quand on n'a pas d'avis." },
    { "id": "ru-expr-015", "cible": "Спасибки!", "accent": "Спаси́бки!", "translit": "spasípki !", "fr": "Merciii !", "note": "Version mignonne de « спасибо ». Entre amis seulement." },
    { "id": "ru-expr-016", "cible": "Пока-пока!", "accent": "Пока́-пока́!", "translit": "paká-paká !", "fr": "Bye-bye !", "note": "Pour finir un appel, avec le sourire." },
    { "id": "ru-expr-017", "cible": "Чао-какао!", "accent": "Ча́о-кака́о!", "translit": "tcháo-kakáo !", "fr": "Ciao-cacao !", "note": "Au revoir pour rire, ça rime." },
    { "id": "ru-expr-018", "cible": "Как жизнь?", "accent": "Как жизнь?", "translit": "kak jizn' ?", "fr": "Alors, la vie ?", "note": "Entre potes. Littéralement « comment (va) la vie ? »." },
    { "id": "ru-expr-019", "cible": "Жесть!", "accent": "Жесть!", "translit": "jest' !", "fr": "Abusé !", "note": "Littéralement « tôle ». Pour une chose dingue ou terrible." },
    { "id": "ru-expr-020", "cible": "Повезло!", "accent": "Повезло́!", "translit": "pavizló !", "fr": "Coup de bol !", "note": "Quand la chance tombe du ciel." },
    { "id": "ru-expr-021", "cible": "Сойдёт.", "accent": "Сойдёт.", "translit": "saïdiót.", "fr": "Ça ira.", "note": "Pas parfait, mais ça fera l'affaire." },
    { "id": "ru-expr-022", "cible": "Короче…", "accent": "Коро́че…", "translit": "karótché…", "fr": "Bref…", "note": "Tic de langage très répandu pour conclure ou raconter vite." },
    { "id": "ru-expr-023", "cible": "Ёлки-палки!", "accent": "Ёлки-па́лки!", "translit": "iólki-pálki !", "fr": "Zut alors !", "note": "Littéralement « sapins-bâtons ». Gentil et un peu rigolo." },
    { "id": "ru-expr-024", "cible": "Я в шоке.", "accent": "Я в шо́ке.", "translit": "ia f chóki.", "fr": "Je suis sous le choc.", "note": "Très courant, souvent pour rire." },
    { "id": "ru-expr-025", "cible": "Обалдеть!", "accent": "Обалде́ть!", "translit": "abaldiét' !", "fr": "Dingue !", "note": "Familier, pour une chose qui laisse sans voix." },
    { "id": "ru-expr-026", "cible": "Прикольно!", "accent": "Прико́льно!", "translit": "prikólna !", "fr": "Sympa ! / Marrant !", "note": "Familier : pour tout ce qui est cool ou drôle." },
    { "id": "ru-expr-027", "cible": "Ну ты даёшь!", "accent": "Ну ты даёшь!", "translit": "nou ty daïóch' !", "fr": "T'es incroyable !", "note": "Admiratif ou moqueur, selon le ton." },
    { "id": "ru-expr-028", "cible": "Бывает.", "accent": "Быва́ет.", "translit": "byváiet.", "fr": "Ça arrive.", "note": "Pour dédramatiser une petite galère, avec un haussement d'épaules." },
    { "id": "ru-expr-029", "cible": "На здоровье!", "accent": "На здоро́вье!", "translit": "na zdaróvié !", "fr": "Je t'en prie !", "note": "Réponse à « merci », surtout après un repas. Pour trinquer : « За здоровье ! »." },
    { "id": "ru-expr-030", "cible": "Ура!", "accent": "Ура́!", "translit": "ourá !", "fr": "Hourra !", "note": "Le cri de joie, le même qu'en français." }
  ]
}
