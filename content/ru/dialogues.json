      "id": "ru-dialogue-cafe",
      "situation": "cafe",
      "titre": "Au comptoir",
      "scene_fr": "Tu es au comptoir d'un café.",
      "registre": "vous",
      "partenaire": { "role_fr": "La serveuse" },
      "exige": [],
