      "echanges": [
        {
          "id": "e1",
          "partenaire": {
            "fr": "Bonjour ! Qu'est-ce que vous prenez ?",
            "cible": "Здравствуйте! Что будете заказывать?",
            "accent": "Здра́вствуйте! Что бу́дете зака́зывать?",
            "translit": "zdrástvouïti! chto boúditi zakázyvat?"
          },
          "si_faux": "a",
          "reponses": [
            {
              "id": "a", "juste": true, "suite": "e2",
              "element": "ru-cafe-002", "remplacement": 0,
              "fr": "Un café, s'il vous plaît.", "cible": "Кофе, пожалуйста.", "accent": "Ко́фе, пожа́луйста.", "translit": "kófi, pajálsta"
