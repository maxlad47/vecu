              "id": "a", "juste": true, "suite": "e3",
              "element": "ru-dialogue-cafe-001", "nouveau": true, "situation": "cafe", "registre": "neutre",
              "fr": "Non, merci, c'est tout.", "cible": "Нет, спасибо, всё.", "accent": "Нет, спаси́бо, всё.", "translit": "niet, spassíba, fsio",
              "astuce": "Всё = « c'est tout ». Aussi : Всё, спаси́бо (sans « non »).",
              "reaction": { "fr": "Très bien.", "cible": "Хорошо.", "accent": "Хорошо́.", "translit": "kharachó" }
            },
            {
              "id": "b", "juste": true, "suite": "e3",
              "element": "ru-cafe-007", "remplacement": 4,
              "fr": "Vous avez des desserts ?", "cible": "У вас есть десерты?", "accent": "У вас есть десе́рты?", "translit": "ou vas iest dissiérty?",
              "reaction": {
                "fr": "Oui, des gâteaux et des tartes.",
                "cible": "Да, есть пирожные и пироги.",
                "accent": "Да, есть пиро́жные и пироги́.",
                "translit": "da, iest pirójnyïe i piraguí"
              }
            },
            {
              "id": "c", "juste": false,
              "fr": "Vous êtes d'ici ?", "cible": "Вы отсюда?", "accent": "Вы отсю́да?", "translit": "vy atsioúda?",
              "pourquoi": "Elle propose autre chose à commander : réponds-lui."
            }
          ]
        },
        {
          "id": "e3",
          "partenaire": {
            "fr": "Vous payez comment ?",
            "cible": "Как будете платить?",
            "accent": "Как бу́дете плати́ть?",
            "translit": "kak boúditi platít?"
          },
          "si_faux": "a",
          "reponses": [
            {
              "id": "a", "juste": true, "suite": "e4",
              "element": "ru-cafe-005",
              "fr": "Je peux payer par carte ?", "cible": "Можно картой?", "accent": "Мо́жно ка́ртой?", "translit": "mójna kártaï?"
            },
            {
              "id": "b", "juste": false,
              "fr": "Merci.", "cible": "Спасибо.", "accent": "Спаси́бо.", "translit": "spassíba",
              "pourquoi": "On te demande comment tu paies : réponds avec le paiement."
            },
            {
              "id": "c", "juste": false,
              "fr": "Un thé, s'il vous plaît.", "cible": "Чай, пожалуйста.", "accent": "Чай, пожа́луйста.", "translit": "tchaï, pajálsta",
              "pourquoi": "Tu as déjà commandé : maintenant, on parle du paiement."
            }
          ]
        },
        {
          "id": "e4",
          "partenaire": {
            "fr": "Voilà. Bonne journée !",
            "cible": "Вот, пожалуйста. Хорошего дня!",
            "accent": "Вот, пожа́луйста. Хоро́шего дня!",
            "translit": "vot, pajálsta. kharóchiva dnia!"
          },
          "si_faux": "a",
          "reponses": [
            {
              "id": "a", "juste": true, "suite": null,
              "element": "ru-cafe-010",
              "fr": "Au revoir.", "cible": "До свидания.", "accent": "До свида́ния.", "translit": "da svidánia"
            },
            {
              "id": "b", "juste": false,
              "fr": "Je ne comprends pas.", "cible": "Я не понимаю.", "accent": "Я не понима́ю.", "translit": "ia ni panimáiou",
              "pourquoi": "Elle te souhaite une bonne journée : dis au revoir."
            }
          ]
        }
      ]
    },
