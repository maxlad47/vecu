            {
              "id": "c", "juste": false,
              "fr": "Où sont les toilettes ?", "cible": "Где туалет?", "accent": "Где туале́т?", "translit": "gdie toualiét?",
              "pourquoi": "La serveuse te demande ce que tu prends."
